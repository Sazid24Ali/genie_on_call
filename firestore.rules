rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own document
    match /users/{userId} {
      allow read, write,update: if request.auth != null && request.auth.uid == userId;
    }

    // Agents can read/write their own document
    match /agents/{agentId} {
      allow read, write: if request.auth != null;
    }

    // Services are readable by all authenticated users and CX
    match /services/{serviceId} {
      allow read: if request.auth != null || true;
    }

    // CX login: allow read for CX authentication
    match /cx_logins/{cxId} {
      allow read: if true; // Allow read for CX login check
    }

    // Bookings: allow read for authenticated users and CX
    match /bookings/{bookingId} {
      allow read: if true; // Allow CX to read bookings for chat functionality
      allow create: if request.auth != null;
      allow write, update, delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.agentId == request.auth.uid) ||
        request.auth == null; // Allow CX to update bookings (CX is not authenticated)
    }

    // Agents: allow read for authenticated users and CX
    match /agents/{agentId} {
      allow read: if request.auth != null || true; // Allow CX read
      allow write: if request.auth != null;
    }

    // Available slots: allow read/write for authenticated users
    match /available_slots/{slotId} {
      allow read, write: if request.auth != null;
    }

    // Chat: allow read/write for CX
    match /chats/{room} {
      allow read, write: if true;
    }
    match /chats/{room}/messages/{message} {
      allow read, write: if true;
    }

    // Chat requests: allow read/write for CX
    match /chat_requests/{requestId} {
      allow read, write: if true;
    }
  }
}
