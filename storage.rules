rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write for chat attachments without auth (for CX users)
    match /chat_attachments/{allPaths=**} {
      allow read, write: if true;
    }
    // Test mode: Allow all authenticated users to read/write for other paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
